#!/usr/bin/env bash
set -Eeuo pipefail

instance="${1:?Usage: auto-deploy-project-runner <instance>}"
env_file="/etc/auto_deploy/projects/${instance}.env"

if [ ! -r "${env_file}" ]; then
  echo "project environment file is missing or unreadable: ${env_file}" >&2
  exit 2
fi

# shellcheck disable=SC1090
source "${env_file}"

: "${PROJECT_KEY:?PROJECT_KEY is required}"
: "${PROJECT_RUNTIME:?PROJECT_RUNTIME is required}"
: "${PROJECT_PATH:?PROJECT_PATH is required}"
: "${PROJECT_PORT:?PROJECT_PORT is required}"
: "${PROJECT_START_COMMAND:?PROJECT_START_COMMAND is required}"

cd "${PROJECT_PATH}"
export PORT="${PROJECT_PORT}"
export HOST="${PROJECT_HOST:-0.0.0.0}"
export HOSTNAME="${PROJECT_HOSTNAME:-0.0.0.0}"

exec bash -lc "${PROJECT_START_COMMAND}"
