#!/usr/bin/env bash
set -Eeuo pipefail

action="${1:-}"
unit="auto-deploy-web.service"

case "${action}" in
  check-permission)
    echo "OK"
    ;;
  start|stop|restart|status|is-active|reset-failed)
    systemctl "${action}" "${unit}"
    ;;
  *)
    echo "Usage: auto-deploy-web-control {check-permission|start|stop|restart|status|is-active|reset-failed}" >&2
    exit 2
    ;;
esac
